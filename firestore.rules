rules_version = '2';

// Phase 1 : tout est refusé par défaut.
// Les vraies règles (membres, organisateur, journal en ajout uniquement) arrivent en phase 2,
// accompagnées de leurs tests avec l'émulateur.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
