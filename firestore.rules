rules_version = '2';

// Règles de sécurité de Cloud Firestore.
// Il n'y a pas de serveur entre l'application et la base : ces règles sont la seule protection.
// Le modèle de données est décrit dans docs/data-model.md ; chaque règle est testée dans
// tests/rules/firestore.rules.test.js.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------- Outils

    function signedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function onlyChanged(keys) {
      return changedKeys().hasOnly(keys);
    }

    function isNow(value) {
      return value == request.time;
    }

    function isText(value, min, max) {
      return value is string && value.size() >= min && value.size() <= max;
    }

    function isIntBetween(value, min, max) {
      return value is int && value >= min && value <= max;
    }

    function isIsoDate(value) {
      return value is string && value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    // « AAAA-MM-JJ » → horodatage à minuit UTC (= minuit à Abidjan).
    function isoToTimestamp(iso) {
      return timestamp.date(int(iso[0:4]), int(iso[5:7]), int(iso[8:10]));
    }

    function tontinePath(tontineId) {
      return /databases/$(database)/documents/tontines/$(tontineId);
    }

    function tontineOf(tontineId) {
      return get(tontinePath(tontineId)).data;
    }

    function tontineAfter(tontineId) {
      return getAfter(tontinePath(tontineId)).data;
    }

    function memberPath(tontineId, userId) {
      return /databases/$(database)/documents/tontines/$(tontineId)/members/$(userId);
    }

    function roundPath(tontineId, index) {
      return /databases/$(database)/documents/tontines/$(tontineId)/rounds/$(string(index));
    }

    function isMemberOf(t) {
      return signedIn() && uid() in t.memberIds;
    }

    // Administrateur de la plateforme (back-office) : lecture seule de l'ensemble des données,
    // sauf les coordonnées privées des membres sans compte et les notifications personnelles.
    // Le document admins/{uid} n'est créé que côté serveur (script make-admin).
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(uid()));
    }

    function isOwnerOf(t) {
      return signedIn() && t.ownerId == uid();
    }

    // Organisateur ou co-organisateur : peut confirmer ou rejeter les paiements.
    function isManagerOf(t) {
      return isOwnerOf(t) || (signedIn() && uid() in t.coOrganizerIds);
    }

    function isDrawn(t) {
      return 'drawAt' in t;
    }

    // Nombre de dépôts avant chaque remise du pot (absent = 1, tontines plus anciennes).
    function perRound(t) {
      return t.get('depositsPerRound', 1);
    }

    // Membre sans compte (ajouté par l'organisateur) : identifiant « guest_ » + 20 caractères.
    // Aucun identifiant Firebase Auth ne contient « _ » : pas de confusion possible.
    function isGuestId(id) {
      return id is string && id.matches('^guest_[A-Za-z0-9]{20}$');
    }

    // ------------------------------------------------------------ Utilisateurs

    function validUser(d) {
      return d.keys().hasAll(['firstName', 'lastName', 'email', 'phone', 'createdAt', 'updatedAt'])
        && d.keys().hasOnly(['firstName', 'lastName', 'email', 'phone', 'photoURL', 'emailNotifications', 'createdAt', 'updatedAt'])
        && (!('emailNotifications' in d) || d.emailNotifications is bool)
        && isText(d.firstName, 1, 60)
        && isText(d.lastName, 1, 60)
        && isText(d.email, 3, 200)
        && d.phone is string
        && d.phone.matches('^[+]225(01|05|07|21|25|27)[0-9]{8}$')
        && (!('photoURL' in d) || d.photoURL == null || isText(d.photoURL, 1, 2000))
        && isNow(d.updatedAt);
    }

    match /admins/{userId} {
      allow get: if signedIn() && uid() == userId;
      allow list, write: if false;
    }

    match /users/{userId} {
      allow get: if (signedIn() && uid() == userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if signedIn() && uid() == userId
        && validUser(incoming()) && isNow(incoming().createdAt);
      allow update: if signedIn() && uid() == userId
        && validUser(incoming()) && incoming().createdAt == existing().createdAt;
      // Suppression du compte (loi ivoirienne n° 2013-450 sur les données personnelles).
      allow delete: if signedIn() && uid() == userId;
    }

    // -------------------------------------------------------------- Invitations
    // invites/{code} permet de trouver une tontine par son code sans pouvoir la lire.

    function validInvite(d) {
      return d.keys().hasOnly(['tontineId', 'tontineName', 'ownerId', 'ownerName', 'amount', 'frequency', 'depositsPerRound', 'totalShares', 'createdAt'])
        && d.tontineId is string
        && isText(d.tontineName, 2, 80)
        && isText(d.ownerName, 1, 130)
        && d.amount is int
        && d.frequency is string
        && d.totalShares is int;
    }

    match /invites/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && code.matches('^[A-Z0-9]{6}$')
        && validInvite(incoming())
        && isNow(incoming().createdAt)
        && tontineAfter(incoming().tontineId).ownerId == uid()
        && tontineAfter(incoming().tontineId).inviteCode == code;
      allow update: if signedIn() && validInvite(incoming())
        && incoming().tontineId == existing().tontineId
        && incoming().createdAt == existing().createdAt
        && tontineOf(existing().tontineId).ownerId == uid();
      allow delete: if signedIn() && tontineOf(existing().tontineId).ownerId == uid();
    }

    // ----------------------------------------------------------------- Tontines

    function tontineKeys() {
      return ['name', 'description', 'amount', 'frequency', 'depositsPerRound', 'startDate', 'totalShares',
        'graceDays', 'penaltyAmount', 'status', 'ownerId', 'ownerName', 'inviteCode',
        'memberIds', 'coOrganizerIds', 'orderMode', 'payoutOrder', 'drawAt', 'drawBy',
        'activatedAt', 'closedAt', 'createdAt', 'updatedAt'];
    }

    function validSettings(d) {
      return d.keys().hasOnly(tontineKeys())
        && isText(d.name, 2, 80)
        && isText(d.description, 0, 500)
        && isIntBetween(d.amount, 100, 100000000)
        && d.frequency in ['DAILY', 'EVERY_2_DAYS', 'WEEKLY', 'BIWEEKLY', 'MONTHLY', 'EVERY_2_MONTHS', 'QUARTERLY', 'SEMIANNUAL', 'EVERY_9_MONTHS']
        && (!('depositsPerRound' in d) || isIntBetween(d.depositsPerRound, 1, 366))
        && isIsoDate(d.startDate)
        && isIntBetween(d.totalShares, 2, 60)
        && isIntBetween(d.graceDays, 0, 30)
        && isIntBetween(d.penaltyAmount, 0, 100000000)
        && d.status in ['DRAFT', 'ACTIVE', 'COMPLETED', 'CANCELLED']
        && d.orderMode in ['MANUAL', 'DRAW']
        && d.memberIds is list
        && d.coOrganizerIds is list
        && d.payoutOrder is list
        && d.payoutOrder.size() <= d.totalShares
        && d.ownerId in d.memberIds
        && d.memberIds.hasAll(d.coOrganizerIds)
        && isNow(d.updatedAt);
    }

    function validNewTontine(d) {
      return validSettings(d)
        && d.ownerId == uid()
        && isText(d.ownerName, 1, 130)
        && d.inviteCode is string
        && d.status == 'DRAFT'
        && d.memberIds == [uid()]
        && d.coOrganizerIds == []
        && d.payoutOrder == []
        && !('drawAt' in d)
        && !('activatedAt' in d)
        && !('closedAt' in d)
        && isNow(d.createdAt);
    }

    function validStatusChange(from, to) {
      return from == to
        || (from == 'DRAFT' && to in ['ACTIVE', 'CANCELLED'])
        || (from == 'ACTIVE' && to in ['COMPLETED', 'CANCELLED']);
    }

    function validTontineUpdate(r, d) {
      return validSettings(d)
        && d.ownerId == r.ownerId
        && d.ownerName == r.ownerName
        && d.inviteCode == r.inviteCode
        && d.createdAt == r.createdAt
        && validStatusChange(r.status, d.status)
        // Montant, fréquence, calendrier, parts, ordre et membres sont figés après le démarrage.
        && (r.status == 'DRAFT' || (
          d.amount == r.amount && d.frequency == r.frequency && d.startDate == r.startDate
          && d.totalShares == r.totalShares && d.payoutOrder == r.payoutOrder
          && d.orderMode == r.orderMode && d.memberIds == r.memberIds
          && d.graceDays == r.graceDays && d.penaltyAmount == r.penaltyAmount
          && perRound(d) == perRound(r)
        ))
        // Le tirage au sort est enregistré une seule fois : impossible de le relancer.
        && (!isDrawn(r) || (
          d.drawAt == r.drawAt && d.drawBy == r.drawBy && d.payoutOrder == r.payoutOrder
          && d.orderMode == 'DRAW' && d.memberIds == r.memberIds && d.totalShares == r.totalShares
        ))
        && (isDrawn(r) || !isDrawn(d) || (r.status == 'DRAFT' && isNow(d.drawAt) && d.drawBy == uid()
          && d.orderMode == 'DRAW' && d.payoutOrder.size() == d.totalShares))
        // Démarrage : ordre complet et date enregistrée.
        && (r.status != 'DRAFT' || d.status != 'ACTIVE' || (
          d.payoutOrder.size() == d.totalShares && isNow(d.activatedAt)
        ))
        && (r.status == d.status || d.status in ['DRAFT', 'ACTIVE'] || isNow(d.closedAt));
    }

    match /tontines/{tontineId} {
      allow read: if isMemberOf(existing()) || isAdmin();
      allow create: if signedIn() && validNewTontine(incoming());
      allow update: if (isOwnerOf(existing()) && validTontineUpdate(existing(), incoming()))
        || memberLeavesTontine(existing(), incoming());
      allow delete: if false;

      // Un membre (hors organisateur) se retire lui-même tant que la tontine est en préparation.
      function memberLeavesTontine(r, d) {
        return signedIn() && uid() in r.memberIds && uid() != r.ownerId
          && r.status == 'DRAFT' && !isDrawn(r)
          && onlyChanged(['memberIds', 'coOrganizerIds', 'updatedAt'])
          && d.memberIds == r.memberIds.removeAll([uid()])
          && d.coOrganizerIds == r.coOrganizerIds.removeAll([uid()])
          && isNow(d.updatedAt);
      }

      // ------------------------------------------------------------- Membres

      function validMember(d) {
        return d.keys().hasOnly(['userId', 'displayName', 'phone', 'tontineName', 'role', 'shares', 'status', 'isGuest', 'joinedAt', 'updatedAt'])
          && d.keys().hasAll(['userId', 'displayName', 'phone', 'role', 'shares', 'status', 'joinedAt', 'updatedAt'])
          && isText(d.displayName, 1, 130)
          && isText(d.phone, 0, 20)
          && d.role in ['ORGANIZER', 'CO_ORGANIZER', 'MEMBER']
          && isIntBetween(d.shares, 1, 10)
          && d.status in ['PENDING', 'ACTIVE', 'REFUSED', 'LEFT']
          && (!('isGuest' in d) || d.isGuest == true)
          && isNow(d.updatedAt);
      }

      // Les membres peuvent changer tant que la tontine est en préparation et non tirée au sort.
      function membershipOpen(t) {
        return t.status == 'DRAFT' && !isDrawn(t);
      }

      match /members/{memberId} {
        allow read: if isMemberOf(tontineOf(tontineId))
          || (signedIn() && memberId == uid())
          || isAdmin();

        allow create: if (selfCreatesMember() || ownerAddsGuest());

        function selfCreatesMember() {
          return signedIn() && memberId == uid()
          && validMember(incoming())
          && incoming().userId == uid()
          && !('isGuest' in incoming())
          && isNow(incoming().joinedAt)
          && (
            // Demande pour rejoindre (via le code d'invitation)
            (incoming().status == 'PENDING' && incoming().role == 'MEMBER'
              && membershipOpen(tontineOf(tontineId)))
            // L'organisateur, au moment de la création de la tontine
            || (incoming().status == 'ACTIVE' && incoming().role == 'ORGANIZER'
              && !exists(tontinePath(tontineId))
              && tontineAfter(tontineId).ownerId == uid())
          );
        }

        // L'organisateur ajoute lui-même une personne qui n'a pas de compte.
        // Dans le même lot, son identifiant est ajouté à memberIds.
        function ownerAddsGuest() {
          let t = tontineOf(tontineId);
          return isOwnerOf(t) && membershipOpen(t)
            && isGuestId(memberId)
            && validMember(incoming())
            && incoming().userId == memberId
            && incoming().isGuest == true
            && incoming().status == 'ACTIVE'
            && incoming().role == 'MEMBER'
            && isNow(incoming().joinedAt)
            && memberId in tontineAfter(tontineId).memberIds;
        }

        allow update: if validMember(incoming())
          && incoming().userId == existing().userId
          && incoming().joinedAt == existing().joinedAt
          && (ownerUpdatesMember() || memberUpdatesSelf());

        allow delete: if false;

        function ownerUpdatesMember() {
          let t = tontineOf(tontineId);
          let isSelf = memberId == t.ownerId;
          return isOwnerOf(t)
            && (!isSelf || (incoming().role == 'ORGANIZER' && incoming().status == 'ACTIVE'))
            && (isSelf || incoming().role != 'ORGANIZER')
            // Un membre sans compte ne peut pas être co-organisateur (il ne se connecte jamais).
            && (!isGuestId(memberId) || incoming().role == 'MEMBER')
            && (
              // En préparation : accepter, refuser, retirer, changer les parts ou le rôle
              (membershipOpen(t) && onlyChanged(['role', 'shares', 'status', 'updatedAt']))
              // Après : seul le rôle (co-organisateur) peut changer
              || onlyChanged(['role', 'updatedAt'])
            );
        }

        function memberUpdatesSelf() {
          let t = tontineOf(tontineId);
          return signedIn() && memberId == uid() && uid() != t.ownerId
            && membershipOpen(t)
            && onlyChanged(['status', 'shares', 'displayName', 'phone', 'role', 'updatedAt'])
            && incoming().role == 'MEMBER'
            && (
              // Quitter ou annuler sa demande
              (existing().status in ['PENDING', 'ACTIVE'] && incoming().status == 'LEFT')
              // Refaire une demande après un refus ou un départ
              || (existing().status in ['REFUSED', 'LEFT'] && incoming().status == 'PENDING')
              // Modifier sa demande en attente
              || (existing().status == 'PENDING' && incoming().status == 'PENDING')
            );
        }
      }

      // ------------------------------------- Coordonnées privées des membres sans compte
      // E-mail facultatif, utilisé uniquement pour les e-mails : lisible par l'organisateur seul.

      match /guestContacts/{guestId} {
        allow read, delete: if isOwnerOf(tontineOf(tontineId));
        allow create, update: if isOwnerOf(tontineOf(tontineId))
          && isGuestId(guestId)
          && existsAfter(memberPath(tontineId, guestId))
          && incoming().keys().hasOnly(['email', 'updatedAt'])
          && isText(incoming().email, 3, 200)
          && incoming().email.matches('^[^@ ]+@[^@ ]+[.][^@ ]+$')
          && isNow(incoming().updatedAt);
      }

      // ---------------------------------------------------------------- Tours

      match /rounds/{roundId} {
        allow read: if isMemberOf(tontineOf(tontineId)) || isAdmin();

        // Créés en un seul lot au démarrage de la tontine, à partir de l'ordre de passage.
        allow create: if isOwnerOf(tontineOf(tontineId))
          && tontineOf(tontineId).status == 'DRAFT'
          && tontineAfter(tontineId).status == 'ACTIVE'
          && validNewRound(tontineAfter(tontineId), incoming());

        allow update: if ownerSendsPayout() || beneficiaryConfirmsPayout() || ownerConfirmsGuestPayout();
        allow delete: if false;

        function validNewRound(t, d) {
          return d.keys().hasOnly(['index', 'dueDate', 'depositDates', 'beneficiaryId', 'beneficiaryName', 'shareNumber', 'potAmount', 'payoutStatus', 'createdAt', 'updatedAt'])
            && isIntBetween(d.index, 1, t.totalShares)
            && roundId == string(d.index)
            && isIsoDate(d.dueDate)
            && d.beneficiaryId == t.payoutOrder[d.index - 1].memberId
            && d.beneficiaryName is string
            && d.shareNumber is int
            && d.potAmount == t.amount * t.totalShares * perRound(t)
            // Plusieurs dépôts par tour : leurs dates, la dernière étant la remise du pot.
            && (perRound(t) == 1
              ? !('depositDates' in d)
              : (d.depositDates is list && d.depositDates.size() == perRound(t)
                && d.depositDates[perRound(t) - 1] == d.dueDate))
            && d.payoutStatus == 'PENDING'
            && isNow(d.createdAt)
            && isNow(d.updatedAt);
        }

        function ownerSendsPayout() {
          let t = tontineOf(tontineId);
          return isOwnerOf(t) && t.status == 'ACTIVE'
            && existing().payoutStatus == 'PENDING'
            && incoming().payoutStatus == 'SENT'
            && onlyChanged(['payoutStatus', 'payoutMethod', 'payoutReference', 'payoutSentAt', 'payoutSentBy', 'updatedAt'])
            && incoming().payoutMethod in ['CASH', 'WAVE', 'ORANGE_MONEY', 'MTN_MOMO', 'MOOV_MONEY', 'BANK_TRANSFER']
            && isText(incoming().payoutReference, 0, 100)
            && isNow(incoming().payoutSentAt)
            && incoming().payoutSentBy == uid()
            && isNow(incoming().updatedAt);
        }

        // Bénéficiaire sans compte : l'organisateur confirme la remise à sa place.
        function ownerConfirmsGuestPayout() {
          return isOwnerOf(tontineOf(tontineId))
            && isGuestId(existing().beneficiaryId)
            && existing().payoutStatus == 'SENT'
            && incoming().payoutStatus == 'RECEIVED'
            && onlyChanged(['payoutStatus', 'payoutConfirmedAt', 'updatedAt'])
            && isNow(incoming().payoutConfirmedAt)
            && isNow(incoming().updatedAt);
        }

        function beneficiaryConfirmsPayout() {
          return signedIn() && existing().beneficiaryId == uid()
            && existing().payoutStatus == 'SENT'
            && incoming().payoutStatus == 'RECEIVED'
            && onlyChanged(['payoutStatus', 'payoutConfirmedAt', 'updatedAt'])
            && isNow(incoming().payoutConfirmedAt)
            && isNow(incoming().updatedAt);
        }
      }

      // ---------------------------------------------------------- Cotisations
      // Identifiant : « {numéro du dépôt}_{id du membre} » (une cotisation par membre et par dépôt).
      // Avec un dépôt par tour, le numéro du dépôt est celui du tour (et depositIndex peut manquer).

      match /contributions/{contributionId} {
        allow read: if isMemberOf(tontineOf(tontineId)) || isAdmin();
        allow create: if validNewContribution()
          && (memberDeclares() || managerRecordsCash() || ownerAppliesPenaltyOnMissing());
        allow update: if unchangedIdentity()
          && (memberRedeclares() || managerReviews() || managerRecordsCashOnExisting() || ownerAppliesPenalty());
        allow delete: if false;

        function contributionKeys() {
          return ['roundIndex', 'depositIndex', 'memberId', 'memberName', 'amount', 'penaltyAmount', 'method',
            'reference', 'proofPath', 'status', 'declaredAt', 'confirmedAt', 'confirmedBy',
            'rejectedAt', 'rejectedBy', 'rejectionReason', 'penaltyAppliedAt', 'updatedAt'];
        }

        function methods() {
          return ['CASH', 'WAVE', 'ORANGE_MONEY', 'MTN_MOMO', 'MOOV_MONEY', 'BANK_TRANSFER'];
        }

        function memberOfContribution(d) {
          return get(memberPath(tontineId, d.memberId)).data;
        }

        function roundOf(d) {
          return get(roundPath(tontineId, d.roundIndex)).data;
        }

        function depositIndexOf(d) {
          return d.get('depositIndex', d.roundIndex);
        }

        // Date du dépôt : enregistrée avec le tour (depositDates), ou la date du tour.
        function depositDueDate(t, d) {
          let r = roundOf(d);
          return perRound(t) == 1 ? r.dueDate : r.depositDates[(depositIndexOf(d) - 1) % perRound(t)];
        }

        // Retard : après la date du dépôt + le délai de grâce (jour J + N inclus).
        function isPastGrace(t, d) {
          return request.time >= isoToTimestamp(depositDueDate(t, d)) + duration.value(t.graceDays + 1, 'd');
        }

        function validNewContribution() {
          let d = incoming();
          let t = tontineOf(tontineId);
          return d.keys().hasOnly(contributionKeys())
            && t.status == 'ACTIVE'
            && isIntBetween(d.roundIndex, 1, t.totalShares)
            && isIntBetween(depositIndexOf(d), 1, t.totalShares * perRound(t))
            // Le dépôt appartient bien à ce tour.
            && (depositIndexOf(d) - 1 - (depositIndexOf(d) - 1) % perRound(t)) == (d.roundIndex - 1) * perRound(t)
            && contributionId == string(depositIndexOf(d)) + '_' + d.memberId
            && d.memberId in t.memberIds
            && memberOfContribution(d).status == 'ACTIVE'
            && isText(d.memberName, 1, 130)
            // Le montant doit correspondre à la cotisation × parts du membre.
            && d.amount == t.amount * memberOfContribution(d).shares
            && isNow(d.updatedAt);
        }

        // La preuve est rangée dans le dossier de la personne qui l'a envoyée
        // (le membre qui déclare, ou l'organisateur qui enregistre le paiement).
        function validProof(path, uploaderId) {
          return path == null || (path is string
            && path.matches('^proofs/' + tontineId + '/' + uploaderId + '/.+'));
        }

        function validDeclaration(d, uploaderId) {
          return d.method in methods()
            && isText(d.reference, 0, 100)
            && validProof(d.get('proofPath', null), uploaderId)
            && isNow(d.declaredAt);
        }

        function memberDeclares() {
          let d = incoming();
          return d.memberId == uid()
            && d.status == 'DECLARED'
            && d.penaltyAmount == 0
            && validDeclaration(d, d.memberId)
            && !('confirmedAt' in d) && !('confirmedBy' in d) && !('rejectedAt' in d);
        }

        // Paiement remis directement à l'organisateur (espèces…) : enregistré et confirmé.
        function managerRecordsCash() {
          let d = incoming();
          return isManagerOf(tontineOf(tontineId))
            && d.status == 'CONFIRMED'
            && d.penaltyAmount == 0
            && validDeclaration(d, uid())
            && isNow(d.confirmedAt)
            && d.confirmedBy == uid();
        }

        function ownerAppliesPenaltyOnMissing() {
          let d = incoming();
          let t = tontineOf(tontineId);
          return isOwnerOf(t)
            && d.status == 'LATE'
            && t.penaltyAmount > 0
            && d.penaltyAmount == t.penaltyAmount
            && isNow(d.penaltyAppliedAt)
            && isPastGrace(t, d)
            && d.keys().hasOnly(['roundIndex', 'depositIndex', 'memberId', 'memberName', 'amount', 'penaltyAmount', 'status', 'penaltyAppliedAt', 'updatedAt']);
        }

        function unchangedIdentity() {
          return incoming().roundIndex == existing().roundIndex
            && incoming().get('depositIndex', 0) == existing().get('depositIndex', 0)
            && incoming().memberId == existing().memberId
            && incoming().amount == existing().amount
            && incoming().keys().hasOnly(contributionKeys())
            && isNow(incoming().updatedAt)
            && tontineOf(tontineId).status == 'ACTIVE';
        }

        function memberRedeclares() {
          let d = incoming();
          return existing().memberId == uid()
            && existing().status in ['REJECTED', 'LATE']
            && d.status == 'DECLARED'
            && validDeclaration(d, d.memberId)
            && onlyChanged(['status', 'method', 'reference', 'proofPath', 'declaredAt', 'updatedAt']);
        }

        function managerReviews() {
          let d = incoming();
          return isManagerOf(tontineOf(tontineId))
            && existing().status == 'DECLARED'
            && (
              (d.status == 'CONFIRMED'
                && onlyChanged(['status', 'confirmedAt', 'confirmedBy', 'updatedAt'])
                && isNow(d.confirmedAt) && d.confirmedBy == uid())
              || (d.status == 'REJECTED'
                && onlyChanged(['status', 'rejectionReason', 'rejectedAt', 'rejectedBy', 'updatedAt'])
                && isText(d.rejectionReason, 3, 300)
                && isNow(d.rejectedAt) && d.rejectedBy == uid())
            );
        }

        function managerRecordsCashOnExisting() {
          let d = incoming();
          return isManagerOf(tontineOf(tontineId))
            && existing().status in ['REJECTED', 'LATE']
            && d.status == 'CONFIRMED'
            && d.method in methods()
            && isText(d.reference, 0, 100)
            && onlyChanged(['status', 'method', 'reference', 'proofPath', 'declaredAt', 'confirmedAt', 'confirmedBy', 'updatedAt'])
            && (d.get('proofPath', null) == existing().get('proofPath', null)
              || validProof(d.get('proofPath', null), uid()))
            && isNow(d.declaredAt)
            && isNow(d.confirmedAt)
            && d.confirmedBy == uid();
        }

        function ownerAppliesPenalty() {
          let d = incoming();
          let t = tontineOf(tontineId);
          return isOwnerOf(t)
            && t.penaltyAmount > 0
            && existing().status != 'CONFIRMED'
            && existing().get('penaltyAmount', 0) == 0
            && d.penaltyAmount == t.penaltyAmount
            && isNow(d.penaltyAppliedAt)
            && isPastGrace(t, existing())
            && onlyChanged(['penaltyAmount', 'penaltyAppliedAt', 'updatedAt']);
        }
      }

      // ------------------------------------------------- Journal (ajout uniquement)

      match /events/{eventId} {
        allow read: if isMemberOf(tontineOf(tontineId)) || isAdmin();
        // L'auteur doit être membre avant OU après le lot d'écritures
        // (création de la tontine, départ d'un membre…).
        allow create: if signedIn()
          && incoming().keys().hasOnly(['type', 'actorId', 'actorName', 'payload', 'createdAt'])
          && incoming().actorId == uid()
          && isText(incoming().actorName, 1, 130)
          && incoming().type is string
          && incoming().payload is map
          && isNow(incoming().createdAt)
          && (isMemberOf(tontineAfter(tontineId)) || isMemberOf(tontineOf(tontineId)));
        // Personne, pas même l'organisateur, ne peut modifier ou supprimer une entrée.
        allow update, delete: if false;
      }
    }

    // Demandes en attente d'un utilisateur (requête collectionGroup('members')).
    match /{path=**}/members/{memberId} {
      allow read: if (signedIn() && existing().userId == uid()) || isAdmin();
    }

    // Back-office : statistiques et activité de toute la plateforme.
    match /{path=**}/contributions/{contributionId} {
      allow read: if isAdmin();
    }

    match /{path=**}/events/{eventId} {
      allow read: if isAdmin();
    }

    // Journal des e-mails et état du résumé quotidien : écrits par les Cloud Functions seules.
    match /mailLog/{mailId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /digestState/{stateId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ------------------------------------------------------------ Notifications

    function relatedToTontine(tontineId, userId) {
      return userId in tontineAfter(tontineId).memberIds
        || existsAfter(memberPath(tontineId, userId));
    }

    match /notifications/{notificationId} {
      allow read: if signedIn() && existing().userId == uid();
      allow create: if signedIn()
        && incoming().keys().hasOnly(['userId', 'tontineId', 'type', 'message', 'link', 'actorId', 'read', 'createdAt'])
        && incoming().userId is string
        && incoming().tontineId is string
        && incoming().type is string
        && isText(incoming().message, 1, 300)
        && isText(incoming().link, 0, 200)
        && incoming().actorId == uid()
        && incoming().read == false
        && isNow(incoming().createdAt)
        && relatedToTontine(incoming().tontineId, uid())
        && relatedToTontine(incoming().tontineId, incoming().userId);
      allow update: if signedIn() && existing().userId == uid()
        && onlyChanged(['read', 'readAt'])
        && incoming().read == true
        && isNow(incoming().readAt);
      allow delete: if signedIn() && existing().userId == uid();
    }
  }
}
