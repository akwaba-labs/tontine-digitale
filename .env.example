# Copier ce fichier en .env puis remplir avec les valeurs de la console Firebase
# (Paramètres du projet > Vos applications > Application Web > Configuration).
# Le fichier .env ne doit JAMAIS être commité.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# true = l'application se connecte aux émulateurs locaux au lieu du vrai projet.
VITE_USE_EMULATORS=false
# Hôte des émulateurs (127.0.0.1 par défaut).
VITE_EMULATOR_HOST=127.0.0.1

# App Check (production) : clé de site reCAPTCHA Enterprise. Laisser vide en développement.
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=
# Jeton de débogage App Check (développement contre un vrai projet uniquement).
VITE_APPCHECK_DEBUG_TOKEN=
