{
  "name": "tontine-digitale",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:emulators": "vite --mode emulators",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "emulators": "npm run build:functions && firebase emulators:start --project demo-tontine-digitale --import=./emulator-data --export-on-exit=./emulator-data",
    "start": "npm run build:functions && firebase emulators:exec --ui \"vite --mode emulators\"",
    "test:rules": "firebase emulators:exec --config firebase.rules-test.json --only auth,firestore,storage --project demo-tontine-rules \"vitest run --config vitest.rules.config.js\"",
    "seed": "node scripts/seed.js",
    "start:demo": "npm run build:functions && firebase emulators:exec --ui \"node scripts/seed.js && vite --mode emulators\"",
    "deploy": "npm run lint && npm test && npm run build && firebase deploy",
    "deploy:hosting": "npm run build && firebase deploy --only hosting",
    "deploy:rules": "firebase deploy --only firestore:rules,firestore:indexes,storage",
    "postinstall": "npm --prefix functions install",
    "build:functions": "rolldown -c functions/rolldown.config.js && node scripts/ensure-functions-secret.js"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/figtree": "^5.3.0",
    "@hookform/resolvers": "^7.0.5",
    "bootstrap": "^5.3.8",
    "date-fns": "^4.4.0",
    "firebase": "^13.2.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "lucide-react": "^1.72.0",
    "react": "^19.3.1",
    "react-bootstrap": "^2.10.10",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "react-router": "^8.5.1",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.9",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "firebase-admin": "^14.5.0",
    "firebase-tools": "^15.35.0",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "prettier": "^3.9.10",
    "sass": "^1.108.2",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  }
}
