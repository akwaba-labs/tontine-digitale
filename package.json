  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:emulators": "vite --mode emulators",
    "build": "vite build",
    "preview": "vite preview",
