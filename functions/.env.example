# Paramètres des Cloud Functions. Copier en .env.<id-du-projet> pour la production,
# ou en .env.local pour les émulateurs. Sans SMTP_HOST, les e-mails sont simulés (collection mailLog).
FUNCTIONS_REGION=europe-west1
APP_URL=https://votre-projet.web.app
MAIL_FROM=Tontine Digitale <no-reply@votre-domaine.ci>
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
