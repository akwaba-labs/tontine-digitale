# Chargé par « npm run dev:emulators » (mode Vite « emulators »).
# Aucune clé secrète ici : le préfixe « demo- » indique un projet fictif,
# utilisable uniquement avec les émulateurs, sans compte Firebase.
VITE_USE_EMULATORS=true
VITE_EMULATOR_HOST=127.0.0.1
VITE_FIREBASE_PROJECT_ID=demo-tontine-digitale
